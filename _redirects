# Same-origin proxy for the results feed — some networks/adblockers choke on
# third-party *.appwrite.run requests; Netlify fetches it server-side instead.
/api/featured-results  https://687828c60018db97b32d.fra.appwrite.run/featuredResults  200

# Trader public profiles: same-origin proxy to the backend's public endpoint,
# and pretty /@handle URLs rewritten to the profile page (which reads the
# handle from location.pathname).
/api/profile/*  https://api.fxlens.app/api/public/profile/:splat  200
/api/creator-apply  https://api.fxlens.app/api/public/creator-apply  200
/api/townhall/*  https://api.fxlens.app/api/public/townhall/:splat  200
# Live class watch page: guests watch signed out; one POST every 20 s does the
# viewer heartbeat + returns class state and read-only chat (backend function).
/api/liveweb  https://687828c60018db97b32d.fra.appwrite.run/liveweb  200
/to/live/*  /live/index.html  200
/live/*  /live/index.html  200
/to/*  /to/index.html  200
/t/*  /t/index.html  200
/@*  /u/index.html  200
